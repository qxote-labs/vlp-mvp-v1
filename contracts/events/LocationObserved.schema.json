{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vlp.invalid/schemas/events/LocationObserved.schema.json",
  "title": "LocationObserved",
  "description": "위치 관측(지역명 텍스트). GPS 좌표 없음. 출처 AUTO/MANAGER. (명명: PascalCase, 실행계획서 5장. lifecycle_event와의 통일 여부는 JEFLIX [미결])",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "LocationObserved"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "contractId": {
      "type": "string",
      "format": "uuid"
    },
    "deliveryId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "customer",
            "karmaster",
            "shop",
            "admin",
            "system"
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "userId"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "regionText": {
          "type": "string"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "AUTO",
            "MANAGER"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "regionText",
        "sourceType",
        "observedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "version",
    "occurredAt",
    "contractId",
    "deliveryId",
    "actor",
    "payload"
  ],
  "additionalProperties": false
}