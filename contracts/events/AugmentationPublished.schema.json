{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vlp.invalid/schemas/events/AugmentationPublished.schema.json",
  "title": "AugmentationPublished",
  "description": "보강정보가 게시됐다. (명명: PascalCase, 실행계획서 5장. lifecycle_event와의 통일 여부는 JEFLIX [미결])",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "AugmentationPublished"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "contractId": {
      "type": "string",
      "format": "uuid"
    },
    "deliveryId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "customer",
            "karmaster",
            "shop",
            "admin",
            "system"
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "userId"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "augmentationId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "LOCATION",
            "NOTE",
            "CUSTOMIZING"
          ]
        },
        "audience": {
          "type": "string",
          "enum": [
            "INTERNAL",
            "CUSTOMER"
          ]
        }
      },
      "required": [
        "augmentationId",
        "kind",
        "audience"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "version",
    "occurredAt",
    "contractId",
    "deliveryId",
    "actor",
    "payload"
  ],
  "additionalProperties": false
}