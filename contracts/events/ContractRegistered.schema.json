{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vlp.invalid/schemas/events/ContractRegistered.schema.json",
  "title": "ContractRegistered",
  "description": "고객이 계약을 등록했다. 조회번호(claimToken)는 payload에 없다. (명명: PascalCase, 실행계획서 5장. lifecycle_event와의 통일 여부는 JEFLIX [미결])",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "ContractRegistered"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "contractId": {
      "type": "string",
      "format": "uuid"
    },
    "deliveryId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "customer",
            "karmaster",
            "shop",
            "admin",
            "system"
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "userId"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "serviceContractNo": {
          "type": "string",
          "pattern": "^SS-\\d{6}-\\d{4}$"
        },
        "carmasterMatched": {
          "type": "boolean"
        },
        "grantStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "PENDING_CLAIM"
          ]
        },
        "vehicleModel": {
          "type": "string"
        }
      },
      "required": [
        "serviceContractNo",
        "carmasterMatched",
        "grantStatus",
        "vehicleModel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "version",
    "occurredAt",
    "contractId",
    "deliveryId",
    "actor",
    "payload"
  ],
  "additionalProperties": false
}