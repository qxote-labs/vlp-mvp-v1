{
  "name": "vlp-mvp-v1",
  "version": "0.7.0-pwa.0",
  "private": true,
  "description": "자동차 구매-출고-시공-수령 통합 MVP 프로토타입 (v6)",
  "scripts": {
    "serve": "http-server -p 8000 -c-1",
    "test": "node tests/run-all.js",
    "playwright:install": "playwright install chromium",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/run-all.js",
    "openapi:validate": "node tools/validate-openapi.js",
    "mock:server": "node tools/mock-server.js",
    "test:all": "npm run openapi:validate && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "http-server": "^14.1.1",
    "playwright": "^1.62.1",
    "yaml": "^2.9.1"
  }
}
